# Arrow — Caddyfile
#
# ARROW_DOMAIN controls where Caddy listens:
#   :6200              plain HTTP (default dev)
#   :443               HTTPS — Caddy uses its internal CA (self-signed)
#   my.domain.com      HTTPS — automatic Let's Encrypt certificate
#
# Do not edit this file manually when using deploy.sh — it is written
# by the script based on the ARROW_TLS / ARROW_DOMAIN environment variables.

{
    email {$CADDY_EMAIL:admin@example.com}
    admin off
}

{$ARROW_DOMAIN::6200} {

    encode gzip

    # ── Security headers ─────────────────────────────────────────────────
    header {
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        X-XSS-Protection          "1; mode=block"
        Referrer-Policy           "strict-origin-when-cross-origin"
        # Allow mic + geolocation for voice and GPS features
        Permissions-Policy        "microphone=*, geolocation=*"
        -Server
        -X-Powered-By
    }

    # ── Backend REST + WebSocket ─────────────────────────────────────────
    @backend { path /api/* }
    handle @backend {
        uri strip_prefix /api
        reverse_proxy backend:6001
    }

    @ws { path /ws /mumble/voice* }
    handle @ws {
        reverse_proxy backend:6001
    }

    # ── Flask web app ────────────────────────────────────────────────────
    handle {
        reverse_proxy web:6002
    }
}
