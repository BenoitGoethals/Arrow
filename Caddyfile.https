# Arrow — HTTPS Caddyfile (explicit self-signed cert)
#
# The cert is generated by deploy.sh (openssl) and mounted into the container.
# It covers all IP addresses specified via ARROW_WEB_EXTRA_IPS.
# Browser shows a warning once — click Advanced → Proceed.

{
    email {$CADDY_EMAIL:admin@example.com}
    admin off
}

{$ARROW_DOMAIN::6200} {

    # Use the cert generated by deploy.sh (covers all server IPs)
    tls /certs/web-cert.pem /certs/web-key.pem

    encode gzip

    header {
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        X-XSS-Protection          "1; mode=block"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "microphone=*, geolocation=*"
        Strict-Transport-Security "max-age=63072000; includeSubDomains"
        -Server
        -X-Powered-By
    }

    @backend { path /api/* }
    handle @backend {
        uri strip_prefix /api
        reverse_proxy backend:6001
    }

    @ws { path /ws /mumble/voice* }
    handle @ws {
        reverse_proxy backend:6001
    }

    handle {
        reverse_proxy web:6002
    }
}
