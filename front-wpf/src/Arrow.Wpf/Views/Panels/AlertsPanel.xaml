<UserControl x:Class="Arrow.Wpf.Views.Panels.AlertsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Arrow.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance vm:AlertsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Background="{StaticResource Bg1Brush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="ALERTS"
                       Foreground="{StaticResource AccentRedBrush}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="10"
                       FontWeight="Bold" />
        </Border>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Alerts}"
                 Background="Transparent"
                 BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Type}"
                                           Foreground="{StaticResource AccentRedBrush}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontWeight="Bold" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Status}"
                                           Foreground="{StaticResource TextDimBrush}"
                                           FontSize="10" />
                            </Grid>
                            <TextBlock Foreground="{StaticResource TextDimBrush}"
                                       FontSize="11"
                                       Margin="0,2,0,0">
                                <Run Text="From: " />
                                <Run Text="{Binding Callsign, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
