<UserControl x:Class="Arrow.Wpf.Views.Panels.MissionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Arrow.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance vm:MissionsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Background="{StaticResource Bg1Brush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="MISSIONS"
                       Foreground="{StaticResource TextDimBrush}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="10"
                       FontWeight="Bold" />
        </Border>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Missions}"
                 SelectedItem="{Binding SelectedMission}"
                 Background="Transparent"
                 BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Status}"
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="10" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
