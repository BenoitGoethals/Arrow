<UserControl x:Class="Arrow.Wpf.Views.Panels.MessagesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Arrow.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance vm:MessagesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Background="{StaticResource Bg1Brush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="MESSAGES"
                       Foreground="{StaticResource TextDimBrush}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="10"
                       FontWeight="Bold" />
        </Border>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Messages}"
                 Background="Transparent"
                 BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock FontSize="10" Foreground="{StaticResource TextDimBrush}">
                                <Run Text="{Binding SenderCallsign, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                                <Run Text=" · " />
                                <Run Text="{Binding Timestamp, StringFormat=HH:mm:ss}" />
                                <Run Text=" · " />
                                <Run Text="{Binding MessageType, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Content}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding DraftContent, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Type a broadcast message" />
            <Button Grid.Column="1"
                    Content="Send"
                    Command="{Binding SendBroadcastCommand}"
                    Background="{StaticResource AccentBlueBrush}"
                    Foreground="White"
                    Margin="5,0,0,0" />
        </Grid>
    </Grid>
</UserControl>
