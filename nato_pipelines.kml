      <Point><coordinates>24.15,35.53,0</coordinates></Point>
    </Placemark>

    <!-- ════════════════════════════════════════════════════════════════════
         Turkish Pipeline System (TUPS — eastern + western branches)
         ════════════════════════════════════════════════════════════════════ -->

    <Placemark>
      <name>TUPS — Iskenderun ↔ Adana ↔ Incirlik</name>
      <description>Eastern branch from the Mediterranean intake at Iskenderun to Incirlik AB.</description>
      <styleUrl>#turk</styleUrl>
      <LineString><coordinates>
        36.17,36.59  35.80,36.80  35.32,36.98  35.43,37.00
      </coordinates></LineString>
    </Placemark>

    <Placemark>
      <name>TUPS — Aegean ↔ Eskişehir ↔ Ankara</name>
      <description>Western branch from the Aegean coast through central Anatolia.</description>
      <styleUrl>#turk</styleUrl>
      <LineString><coordinates>
        27.15,38.42  29.07,40.18  30.52,39.78  32.99,39.95
      </coordinates></LineString>
    </Placemark>

    <Placemark>
