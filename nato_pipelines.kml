      <Point><coordinates>22.41,39.65,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Andravida AB (HPS off-take)</name>
      <styleUrl>#airbase</styleUrl>
      <Point><coordinates>21.30,37.92,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Souda Bay NSA (HPS depot)</name>
