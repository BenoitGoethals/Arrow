<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>NATO Pipeline System (NPS) — overview</name>
    <description>Approximate routings of the NATO multi-fuel pipeline networks operated by NSPA. CEPS (Central Europe), NEPS (North Europe), NIPS (Italy), Greek &amp; Turkish systems, plus major intake/depot/airbase off-takes. Coordinates are nominal — for planning awareness only, not engineering use.</description>

    <!-- ── Style catalogue ─────────────────────────────────────────────── -->
    <Style id="ceps">
      <LineStyle><color>ffffff00</color><width>3</width></LineStyle>
    </Style>
    <Style id="cepsBranch">
      <LineStyle><color>ffffaa00</color><width>2</width></LineStyle>
    </Style>
    <Style id="neps">
      <LineStyle><color>ffff7700</color><width>3</width></LineStyle>
    </Style>
    <Style id="nips">
      <LineStyle><color>ff00aaff</color><width>3</width></LineStyle>
    </Style>
    <Style id="greek">
      <LineStyle><color>ff00ff00</color><width>3</width></LineStyle>
    </Style>
    <Style id="turk">
      <LineStyle><color>ff0000ff</color><width>3</width></LineStyle>
    </Style>
    <Style id="depot">
      <IconStyle><color>ff00ffff</color></IconStyle>
    </Style>
    <Style id="intake">
      <IconStyle><color>ffff00ff</color></IconStyle>
    </Style>
    <Style id="airbase">
      <IconStyle><color>ff00aaff</color></IconStyle>
    </Style>
    <Style id="pumpStation">
      <IconStyle><color>ffffff00</color></IconStyle>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         CEPS — Central Europe Pipeline System
         ~5,300 km across BE / NL / LU / FR / DE serving 31 storage depots
         and 31+ commercial/military off-takes.
         ════════════════════════════════════════════════════════════════════ -->

    <Placemark>
      <name>CEPS — Antwerp ↔ Liège ↔ German border</name>
      <description>Main east branch from Port of Antwerp through the Meuse valley to the German pipeline grid.</description>
      <styleUrl>#ceps</styleUrl>
      <LineString><coordinates>
        4.40,51.23  4.85,51.05  5.30,50.85  5.57,50.65  5.85,50.65  6.05,50.95  6.69,49.97
      </coordinates></LineString>
    </Placemark>

    <Placemark>
      <name>CEPS — Antwerp ↔ Eindhoven ↔ Ruhr</name>
      <description>North-east branch crossing the Belgian-Dutch border, feeding Eindhoven AB and continuing to the Ruhr industrial belt.</description>
      <styleUrl>#ceps</styleUrl>
      <LineString><coordinates>
        4.40,51.23  4.78,51.30  5.10,51.40  5.37,51.45  5.85,51.45  6.10,51.30  6.76,51.27  7.14,50.87
      </coordinates></LineString>
    </Placemark>

    <Placemark>
      <name>CEPS — Rotterdam (Pernis) ↔ Venlo ↔ Ruhr</name>
      <description>Northern intake from the Pernis refinery cluster east through Limburg to the German backbone.</description>
      <styleUrl>#ceps</styleUrl>
      <LineString><coordinates>
        4.39,51.88  4.65,51.85  5.00,51.70  5.50,51.55  6.10,51.45  6.76,51.27
      </coordinates></LineString>
    </Placemark>

    <Placemark>
      <name>CEPS — Pernis ↔ Schiphol off-take</name>
      <description>Jet-A1 supply spur to Schiphol airport.</description>
      <styleUrl>#cepsBranch</styleUrl>
      <LineString><coordinates>
        4.39,51.88  4.55,52.00  4.70,52.15  4.76,52.31
      </coordinates></LineString>
    </Placemark>

    <Placemark>
      <name>CEPS — Brussels off-take</name>
      <description>Spur to Brussels (Zaventem) airport.</description>
      <styleUrl>#cepsBranch</styleUrl>
      <LineString><coordinates>
        4.40,51.23  4.45,50.95  4.48,50.90
      </coordinates></LineString>
    </Placemark>

    <Placemark>
      <name>CEPS — German backbone (Aachen ↔ Frankfurt ↔ Mannheim)</name>
      <description>Cross-Germany trunk feeding the Rhein-Main, Spangdahlem, Ramstein and Mannheim depots.</description>
      <styleUrl>#ceps</styleUrl>
      <LineString><coordinates>
        6.05,50.95  6.69,49.97  7.60,49.44  8.56,50.04  8.51,49.49  7.62,48.55
      </coordinates></LineString>
    </Placemark>

    <Placemark>
      <name>CEPS — Frankfurt (Rhein-Main) off-take</name>
      <description>Spur to Frankfurt airport fuel farm — largest commercial off-take on CEPS.</description>
      <styleUrl>#cepsBranch</styleUrl>
      <LineString><coordinates>
        7.14,50.87  8.10,50.30  8.56,50.04
      </coordinates></LineString>
    </Placemark>

    <Placemark>
      <name>CEPS — Spangdahlem AB off-take</name>
      <description>USAFE F-16 wing; primary CEPS military draw west of the Rhine.</description>
      <styleUrl>#cepsBranch</styleUrl>
      <LineString><coordinates>
        6.05,50.95  6.69,49.97
      </coordinates></LineString>
    </Placemark>

    <Placemark>
      <name>CEPS — Ramstein AB off-take</name>
      <description>USAFE HQ + KC-46/C-5 operations.</description>
      <styleUrl>#cepsBranch</styleUrl>
      <LineString><coordinates>
        6.69,49.97  7.60,49.44
      </coordinates></LineString>
    </Placemark>

    <Placemark>
      <name>CEPS — France west branch (Dunkerque ↔ Cambrai ↔ Metz)</name>
      <description>French segment with intake at Dunkerque/Le Havre, joining the German trunk near Strasbourg.</description>
      <styleUrl>#ceps</styleUrl>
      <LineString><coordinates>
        2.36,51.05  2.80,50.70  3.24,50.18  4.10,49.50  5.00,49.20  6.18,49.12  7.05,48.85  7.62,48.55
      </coordinates></LineString>
    </Placemark>

    <Placemark>
      <name>CEPS — Le Havre intake spur</name>
      <description>Atlantic intake refinery; ties into the western French branch.</description>
      <styleUrl>#cepsBranch</styleUrl>
      <LineString><coordinates>
        0.10,49.49  1.20,49.55  2.20,49.70  3.24,50.18
      </coordinates></LineString>
    </Placemark>

    <Placemark>
      <name>CEPS — Cambrai ↔ Chievres ↔ Antwerp loop</name>
      <description>North-east loop joining the French branch back into the Antwerp hub.</description>
      <styleUrl>#cepsBranch</styleUrl>
      <LineString><coordinates>
        3.24,50.18  3.80,50.55  4.05,50.55  4.40,51.23
      </coordinates></LineString>
    </Placemark>

    <Placemark>
      <name>CEPS — Luxembourg crossover</name>
      <description>Cross-border link between French and German trunk segments.</description>
      <styleUrl>#cepsBranch</styleUrl>
      <LineString><coordinates>
        6.18,49.12  6.13,49.61  6.69,49.97
      </coordinates></LineString>
    </Placemark>

    <!-- ── CEPS — major nodes ──────────────────────────────────────────── -->
    <Placemark>
      <name>Antwerp intake (CEPS hub)</name>
      <description>Sea-water intake refineries (Total, ExxonMobil); main CEPS injection point.</description>
      <styleUrl>#intake</styleUrl>
      <Point><coordinates>4.40,51.23,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Rotterdam–Pernis intake (CEPS)</name>
      <description>Shell Pernis refinery cluster; secondary CEPS injection.</description>
      <styleUrl>#intake</styleUrl>
      <Point><coordinates>4.39,51.88,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Le Havre intake (CEPS)</name>
      <description>Atlantic injection point feeding the French branch.</description>
      <styleUrl>#intake</styleUrl>
      <Point><coordinates>0.10,49.49,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Dunkerque intake (CEPS)</name>
      <description>Northern French injection.</description>
      <styleUrl>#intake</styleUrl>
      <Point><coordinates>2.36,51.05,0</coordinates></Point>
    </Placemark>

    <Placemark>
