      <Point><coordinates>4.48,50.90,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Eindhoven AB (CEPS off-take)</name>
      <styleUrl>#airbase</styleUrl>
      <Point><coordinates>5.37,51.45,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Geilenkirchen AB / NAEW (CEPS off-take)</name>
      <styleUrl>#airbase</styleUrl>
      <Point><coordinates>6.05,50.96,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Köln-Bonn (CEPS pump station)</name>
      <styleUrl>#pumpStation</styleUrl>
      <Point><coordinates>7.14,50.87,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Frankfurt am Main (CEPS off-take)</name>
      <styleUrl>#airbase</styleUrl>
      <Point><coordinates>8.56,50.04,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Spangdahlem AB (CEPS off-take)</name>
      <styleUrl>#airbase</styleUrl>
      <Point><coordinates>6.69,49.97,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Ramstein AB (CEPS off-take)</name>
      <styleUrl>#airbase</styleUrl>
      <Point><coordinates>7.60,49.44,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Mannheim depot (CEPS)</name>
      <styleUrl>#depot</styleUrl>
      <Point><coordinates>8.51,49.49,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Strasbourg (CEPS junction)</name>
      <styleUrl>#pumpStation</styleUrl>
      <Point><coordinates>7.62,48.55,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Cambrai (CEPS junction)</name>
      <styleUrl>#pumpStation</styleUrl>
      <Point><coordinates>3.24,50.18,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Metz / Luxembourg (CEPS junction)</name>
      <styleUrl>#pumpStation</styleUrl>
      <Point><coordinates>6.18,49.12,0</coordinates></Point>
    </Placemark>

    <!-- ════════════════════════════════════════════════════════════════════
         NEPS — North European Pipeline System
         Norway (and the historic UK GPSS, kept here for context although
         the GPSS is now disposed of under MOD ownership).
         ════════════════════════════════════════════════════════════════════ -->

    <Placemark>
      <name>NEPS — Stavanger → Sola AB → Karmøy depot</name>
      <description>Norwegian segment serving Sola AFB and the Karmøy storage cluster.</description>
      <styleUrl>#neps</styleUrl>
      <LineString><coordinates>
        5.73,58.90  5.64,58.88  5.27,59.20
      </coordinates></LineString>
    </Placemark>

    <Placemark>
      <name>NEPS — Trondheim ↔ Værnes AB ↔ Ørland depot</name>
      <description>Central Norway segment feeding Ørland (F-35) and Værnes.</description>
      <styleUrl>#neps</styleUrl>
      <LineString><coordinates>
        10.40,63.42  10.92,63.46  9.60,63.70
      </coordinates></LineString>
    </Placemark>

    <Placemark>
      <name>NEPS — Bodø ↔ Evenes</name>
      <description>Northern segment supporting the new F-35 main operating base at Evenes.</description>
      <styleUrl>#neps</styleUrl>
      <LineString><coordinates>
        14.36,67.27  16.68,68.49
      </coordinates></LineString>
    </Placemark>

    <Placemark>
      <name>Sola AB (NEPS off-take)</name>
      <styleUrl>#airbase</styleUrl>
      <Point><coordinates>5.64,58.88,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Ørland MOB (NEPS off-take)</name>
      <styleUrl>#airbase</styleUrl>
      <Point><coordinates>9.60,63.70,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Evenes MOB (NEPS off-take)</name>
      <styleUrl>#airbase</styleUrl>
      <Point><coordinates>16.68,68.49,0</coordinates></Point>
    </Placemark>

    <!-- ════════════════════════════════════════════════════════════════════
         NIPS — Northern Italy Pipeline System
         Genoa intake → Po valley → Friuli; serves Aviano, Ghedi, Cameri.
         ════════════════════════════════════════════════════════════════════ -->

    <Placemark>
      <name>NIPS — Genoa ↔ Po valley ↔ Aviano</name>
      <description>Tyrrhenian intake at Genoa across the Po plain to Aviano AB (USAFE 31 FW).</description>
      <styleUrl>#nips</styleUrl>
      <LineString><coordinates>
        8.93,44.41  9.70,45.05  10.27,45.43  10.99,45.43  12.10,45.80  12.60,46.03
      </coordinates></LineString>
    </Placemark>

    <Placemark>
      <name>NIPS — Cameri spur</name>
      <description>Spur from the Po backbone to Cameri AB (F-35 FACO).</description>
      <styleUrl>#nips</styleUrl>
      <LineString><coordinates>
        9.70,45.05  8.67,45.55
      </coordinates></LineString>
    </Placemark>

    <Placemark>
      <name>NIPS — Camp Darby (Livorno) spur</name>
      <description>Logistics depot for US Army in Europe; coastal spur off the Tyrrhenian intake.</description>
      <styleUrl>#nips</styleUrl>
      <LineString><coordinates>
        8.93,44.41  9.85,44.10  10.40,43.59
      </coordinates></LineString>
    </Placemark>

    <Placemark>
      <name>Genoa intake (NIPS)</name>
      <styleUrl>#intake</styleUrl>
      <Point><coordinates>8.93,44.41,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Aviano AB (NIPS off-take)</name>
      <styleUrl>#airbase</styleUrl>
      <Point><coordinates>12.60,46.03,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Ghedi AB (NIPS off-take)</name>
      <description>Italian Tornado / F-35 base; B61 nuclear-sharing site.</description>
      <styleUrl>#airbase</styleUrl>
      <Point><coordinates>10.27,45.43,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Cameri AB (NIPS off-take)</name>
      <styleUrl>#airbase</styleUrl>
      <Point><coordinates>8.67,45.55,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Camp Darby (NIPS depot)</name>
      <styleUrl>#depot</styleUrl>
      <Point><coordinates>10.40,43.59,0</coordinates></Point>
    </Placemark>

    <!-- ════════════════════════════════════════════════════════════════════
         Greek Pipeline System (HPS)
         Tied to the Aegean intake; supports Larissa, Andravida, Souda.
         ════════════════════════════════════════════════════════════════════ -->

    <Placemark>
      <name>HPS — Thessaloniki ↔ Larissa</name>
      <description>Aegean intake at Thessaloniki south to the central Greek depots.</description>
      <styleUrl>#greek</styleUrl>
      <LineString><coordinates>
        22.95,40.64  22.70,40.05  22.41,39.65
      </coordinates></LineString>
    </Placemark>

    <Placemark>
