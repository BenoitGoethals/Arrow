    </Placemark>

    <Placemark>
      <name>Incirlik AB (TUPS off-take)</name>
      <description>USAFE detachment + nuclear-sharing site (B61).</description>
      <styleUrl>#airbase</styleUrl>
      <Point><coordinates>35.43,37.00,0</coordinates></Point>
